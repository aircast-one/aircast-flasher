{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aircast Flasher",
  "version": "0.1.0",
  "identifier": "one.aircast.flasher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aircast Flasher",
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 620,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://downloads.aircast.one/flasher/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NzA2RThGQzcwQkU5NQpSV1NWdm5EODZBYUhCMTZDM2dMVVNyUHhES0VkNGdxcFpZc3RlRDhzakdBcGIwM2VQRWNJRzlZeAo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
